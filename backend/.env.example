# Puerto del servidor backend Express
PORT=4000

# Base de datos SQLite local (no requiere servidor externo)
DATABASE_URL="file:./dev.db"

# Secreto para firmar tokens JWT de administración
JWT_SECRET="galeria_prismas_unilibre_jwt_secret_2026_seguro"

# Clave opcional de Google Gemini para el asistente Prisma IA
# Si está vacía, el backend usa automáticamente el motor recomendador local por reglas y catálogo
GEMINI_API_KEY=""

# Origen permitido por CORS (Frontend Vite)
CORS_ORIGIN="http://localhost:5173"
